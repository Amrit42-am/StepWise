{
  "name": "stepwise-dsa",
  "version": "1.0.0",
  "description": "AI-powered DSA learning assistant that teaches through guided hints, not answers",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "NODE_ENV=development nodemon server/server.js",
    "build": "npm install --include=dev --prefix client && npm run build --prefix client",
    "test": "NODE_ENV=test vitest run"
  },
  "keywords": [
    "dsa",
    "algorithms",
    "data-structures",
    "learning",
    "ai-mentor",
    "gemma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
